#!name = LGLoon · YouTube & Spotify
#!desc = YouTube 开关控制复写和脚本，Spotify 开关控制播放广告过滤、歌手列表和账号配置处理。修改 Spotify 选项后重新登录生效。QUIC 规则及 HTTPS 解密域名随整个插件启停。
#!loon_version = 3.5.1(983)
#!date = 2026-11-24 19:41:41
#!homepage = https://github.com/Norvon/LGLoon

[Argument]
youtubeEnabled = switch,true,tag=启用 YouTube
blockUpload = switch,false,tag=YouTube · 隐藏上传按钮
blockShorts = switch,false,tag=YouTube · 隐藏 Shorts 按钮
restoreSubscriptions = switch,false,tag=YouTube · 恢复底栏订阅
debug = switch,false,tag=YouTube · 调试日志
spotifyEnabled = switch,true,tag=启用 Spotify
tab = switch,false,tag=Spotify · 移除底栏创建按钮
useractivity = switch,true,tag=Spotify · 启用 Apple 设备接力

[Rule]
# 让客户端从 QUIC 回落到可复写的 HTTPS，规则随整个插件启停。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
request if ${youtubeEnabled} == true && ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad/ then reject(200)
request if ${spotifyEnabled} == true && ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\//i then reject_dict(200)
request if ${spotifyEnabled} == true && ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone/i as urlMatch then url.replace("https://spclient.wg.spotify.com/artistview/v1/artist/${urlMatch.1}&platform=ipad")

[Script]
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://raw.githubusercontent.com/Norvon/LGLoon/main/scripts/LGLoon-Spotify.js", {${tab}, ${useractivity}}) with enable=${spotifyEnabled}, requires_body=true, binary_body_mode=true, timeout=5, tag="LGLoon Spotify Ads"
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)/ then script("https://raw.githubusercontent.com/Norvon/LGLoon/main/scripts/LGLoon-YouTube.js", {${blockUpload}, ${blockShorts}, ${restoreSubscriptions}, ${debug}}) with enable=${youtubeEnabled}, requires_body=true, binary_body_mode=true, tag="LGLoon YouTube"

[MitM]
hostname = *.googlevideo.com, youtubei.googleapis.com, *-spclient.spotify.com, spclient.wg.spotify.com
